{
  "name": "todolist-api",
  "version": "1.0.0",
  "description": "CRUD API (AWS Lambda + MongoDB Atlas) for managing lists and todos",
  "main": "serverless.yml",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "jest --config jest.config.js --selectProjects integration --runInBand",
    "test:watch": "jest --config jest.config.js --watch",
    "dev": "serverless offline start",
    "deploy": "serverless deploy",
    "deploy:prod": "serverless deploy --stage prod",
    "remove": "serverless remove",
    "remove:prod": "serverless remove --stage prod"
  },
  "license": "MIT",
  "dependencies": {
    "mongoose": "^8.6.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "esbuild": "^0.23.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "serverless": "^3.39.0",
    "serverless-dotenv-plugin": "^6.0.0",
    "serverless-esbuild": "^1.52.1",
    "serverless-offline": "^13.6.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
